---
/**
 * A product: its photos (a slideshow from 1024px, see `ProductGallery.astro`),
 * name and facts, and a bar at the bottom of the screen with four panels
 * (Description, Measurements, Process, Shipping) and "Add to cart". From
 * 1024px the page fits the screen, like the design.
 *
 * The panels are <details> sharing a `name`: the browser opens one at a time,
 * without JavaScript.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { site } from '../../config/site';
import { formatPrice } from '../../lib/format';
import {
  getCollectionsWithProducts,
  productSize,
  productTitle,
  type Collection,
  type Product,
} from '../../lib/shop';

export const getStaticPaths = (async () => {
  const collections = await getCollectionsWithProducts();
  return collections.flatMap(({ collection, products }) =>
    products.map((product) => ({
      params: { slug: product.id },
      props: { product, collection },
    }))
  );
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  collection: Collection;
}

const { product, collection } = Astro.props;
const { Content } = await render(product);
const title = productTitle(product, collection);
const description = product.body?.trim() ?? '';
const [main] = product.data.images;
const { width, depth, height } = product.data.dimensions;

/** Structured data for search engines: a product with a price. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description,
  material: product.data.materials,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    price: product.data.price,
    priceCurrency: site.currency.code,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={title}
  description={description.split('. ')[0]}
  image={{ src: main.src, alt: main.alt }}
  ground="paper"
  schema={schema}
  bottomBar
>
  <div class="flex flex-col gap-3 px-3 pt-16 lg:grid lg:h-svh lg:min-h-[40rem] lg:grid-cols-12 lg:grid-rows-[auto_1fr_auto] lg:gap-y-0 lg:pt-20 lg:pb-1">
    <div class="flex gap-3 lg:col-span-5 lg:col-start-8 lg:row-start-1">
      <Badge size={32} aria-hidden="true">
        {collection.data.order}
      </Badge>
      <div class="text-heading leading-[1.25]">
        <h1>{title}</h1>
        <p>{product.data.year} Collection</p>
      </div>
    </div>

    <dl class="mb-8 flex flex-col gap-1 pl-11 lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:mb-11 lg:self-end">
      <dt class="sr-only">Materials</dt>
      <dd>{product.data.materials}</dd>
      <dt class="sr-only">Size in centimetres (width x depth x height)</dt>
      <dd>{productSize(product)}</dd>
      <dt class="sr-only">Price</dt>
      <dd>{formatPrice(product.data.price)}</dd>
    </dl>

    <ProductGallery
      images={product.data.images}
      class="lg:col-span-7 lg:row-span-3 lg:row-start-1 lg:h-full"
      thumbsClass="lg:col-span-5 lg:col-start-8 lg:row-start-3"
    />
  </div>

  <Fragment slot="fixed">
    <!-- The bar at the bottom: each panel opens above it; "Add to cart" last. -->
    <div class="fixed inset-x-1 bottom-1 z-10 grid grid-cols-2 gap-1 lg:flex">
      {['Description', 'Measurements', 'Process', 'Shipping'].map((label) => (
        <details name="product-info" class="group lg:flex-1">
          <summary class="flex h-8 items-center justify-center rounded-sm bg-white group-open:bg-black group-open:text-white">
            {label}
          </summary>
          <!-- A long text scrolls inside the panel, natively (`data-lenis-prevent`). -->
          <div
            class="card absolute inset-x-0 bottom-full mb-1 max-h-[50svh] overflow-y-auto overscroll-contain bg-white text-copy font-normal"
            data-lenis-prevent
          >
            <div class="max-w-[58rem]">
              {label === 'Description' && <Content />}
              {label === 'Measurements' && (
                <p>
                  Width {width} cm, depth {depth} cm, height {height} cm.
                </p>
              )}
              {label === 'Process' && <p>{collection.data.process}</p>}
              {label === 'Shipping' && <p>{site.shipping}</p>}
            </div>
          </div>
        </details>
      ))}
      <button
        type="button"
        class="col-span-2 h-8 rounded-sm bg-brand text-white lg:w-1/3"
        data-add-to-cart={product.id}
      >
        Add to cart
      </button>
    </div>
  </Fragment>
</BaseLayout>
