---
/**
 * The menu on phones: a black screen with the navigation, opened by the
 * header's "Menu" button. A <dialog>, but not a modal one, so a page transition
 * can play over it: its script (`src/scripts/pages/menu.ts`) keeps the page
 * behind out of reach and closes it with Escape. Above the header, below the
 * transition's layer (`z-20`).
 */
import { site } from '../config/site';
---

<dialog
  id="menu"
  aria-label="Menu"
  class="fixed inset-0 z-20 m-0 size-full bg-black p-3 text-white lg:hidden"
>
  <div class="grid-site items-center">
    <a href="/" class="tap">
      {site.name}
    </a>
    <div class="flex justify-between">
      <button type="button" class="tap" aria-label="Close menu" data-menu-close>
        Menu
      </button>
      <button type="button" class="tap" aria-haspopup="dialog" aria-controls="cart" data-cart-open>
        Cart (<span data-cart-count>0</span>)
      </button>
    </div>
  </div>
  <nav aria-label="Menu" class="absolute inset-x-3 top-1/2 -translate-y-1/2 text-title">
    {site.nav.map((item, index) => (
      <>
        <a href={item.href} class="tap">
          {item.label}
        </a>
        {index < site.nav.length - 1 && ', '}
      </>
    ))}
  </nav>
  {site.template && (
    <p class="absolute inset-x-3 bottom-3">
      A free Astro{' '}
      <a href={site.template} class="tap underline">
        template
      </a>
    </p>
  )}
</dialog>
